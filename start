#!/usr/bin/env bash
set -Eeuo pipefail

SERVER_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$SERVER_DIR/codespaces-port.sh"

if [[ $# -gt 1 ]]; then
  printf 'Usage: %s [--background|--restart|--attach]\n' "${BASH_SOURCE[0]}" >&2
  exit 2
fi
START_MODE="attach"
if [[ $# -eq 1 ]]; then
  case "$1" in
    --attach) START_MODE="attach" ;;
    --background) START_MODE="background" ;;
    --restart) START_MODE="restart" ;;
    *)
      printf 'Usage: %s [--background|--restart|--attach]\n' "${BASH_SOURCE[0]}" >&2
      exit 2
      ;;
  esac
fi

for tool in java git jar; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    printf 'Cannot start: required command "%s" is missing.\n' "$tool" >&2
    exit 1
  fi
done

if [[ ! -f "$SERVER_DIR/main.sh" ]]; then
  printf 'Cannot start: main.sh was not found in %s.\n' "$SERVER_DIR" >&2
  exit 1
fi

if command -v tmux >/dev/null 2>&1 && tmux has-session -t server 2>/dev/null; then
  ensure_codespaces_port_public
  case "$START_MODE" in
    attach)
      exec tmux attach-session -t server
      ;;
    restart)
      backend_pane="$(tmux list-panes -t server -F '#{pane_id} #{pane_current_path}' |
        awk -v path="$SERVER_DIR/server" '$2 == path { print $1; exit }')"
      if [[ -z "$backend_pane" ]]; then
        printf 'Cannot restart: could not find the backend console in tmux session "server".\n' >&2
        exit 1
      fi
      printf 'Stopping the running server gracefully...\n'
      tmux send-keys -t "$backend_pane" 'stop' C-m
      stopped=false
      for attempt in {1..30}; do
        if ! tmux has-session -t server 2>/dev/null; then
          stopped=true
          break
        fi
        read -r -t 1 _ || true
      done
      if [[ "$stopped" != true ]]; then
        printf 'The server did not stop within 30 seconds; refusing to start a duplicate.\n' >&2
        exit 1
      fi
      ;;
    start)
      printf 'Server is already running in tmux session "server". Use %s --background to leave it detached or --restart to restart it.\n' "${BASH_SOURCE[0]}"
      exit 0
      ;;
    background)
      printf 'Server is already running in tmux session "server".\n'
      exit 0
      ;;
  esac
fi

if command -v ss >/dev/null 2>&1 && ss -ltn 2>/dev/null | awk '$4 ~ /:8081$/ { found = 1 } END { exit !found }'; then
  printf 'The server is already listening on port 8081 outside tmux; refusing to start a duplicate.\n'
  exit 0
fi

cd "$SERVER_DIR"
if [[ "$START_MODE" != "background" ]]; then
  export KING24790_START_ATTACH=1
else
  export KING24790_START_ATTACH=0
fi
exec bash ./main.sh